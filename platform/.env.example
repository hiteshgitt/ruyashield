# Owner connection: migrations only (owns tables, bypasses nothing at runtime)
DATABASE_OWNER_URL=postgres://ruya_owner:ruya_owner_dev@127.0.0.1:5450/ruyashield
# Runtime connection: non-owner role, RLS enforced
DATABASE_URL=postgres://ruya_app:ruya_app_dev@127.0.0.1:5450/ruyashield

# dev | oidc. "dev" is a local-only sign-in that is refused when NODE_ENV=production.
AUTH_PROVIDER=dev
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
APP_URL=http://localhost:3200

# Egress guard: allow verification requests to private addresses (dev/test only; refused in production)
EGRESS_ALLOW_PRIVATE=false

SMTP_HOST=127.0.0.1
SMTP_PORT=1035

# HMAC key for assessment job tokens (>= 32 chars). Generate with: openssl rand -base64 48
JOB_TOKEN_SECRET=

# Blocklist check (web.blocklist). Leave empty to keep the check off; it then reports "not configured", never "clean".
# Google Safe Browsing Lookup API v4 key (Google Cloud console). Google's terms allow NON-COMMERCIAL use only;
# for a paid/commercial product use the Google Web Risk API instead.
GOOGLE_SAFE_BROWSING_KEY=
# abuse.ch URLhaus Auth-Key (free account at https://auth.abuse.ch/).
URLHAUS_AUTH_KEY=

# Attack-origin monitoring (/attacks)
# Encrypts stored Cloudflare API tokens (AES-256-GCM, >= 32 chars). Generate with: openssl rand -base64 48
# Changing it makes saved Cloudflare sources show "secret_undecryptable" until they are re-added.
RUYA_SECRETS_KEY=
# Local MaxMind GeoLite2 databases (no IP is sent anywhere for lookup). Download with:
#   MAXMIND_ACCOUNT_ID=... MAXMIND_LICENSE_KEY=... npx tsx scripts/geoip-update.mts data/geoip
# Empty = country/ASN show as "unknown" for log-agent events (Cloudflare events carry their own geo).
GEOIP_COUNTRY_DB_PATH=
GEOIP_ASN_DB_PATH=
# Only needed by scripts/geoip-update.mts, not by the app.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
