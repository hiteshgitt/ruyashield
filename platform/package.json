{
  "name": "platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build",
    "start": "next start -p 3200",
    "lint": "eslint",
    "migrate": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; tsx scripts/migrate.mts",
    "worker": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; tsx scripts/worker.mts",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "test:db": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; vitest run tests/db",
    "verify-fixproof": "tsx scripts/verify-fixproof.mts",
    "ai:eval": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; tsx scripts/ai-eval.mts",
    "referral:funnel": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; tsx scripts/referral-funnel.mts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "gsap": "3.13.0",
    "maxmind": "5.0.7",
    "next": "16.4.3",
    "nodemailer": "^10.3.1",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
